+    <path d="M16 12h6m-2.5-2.5L22 12l-2.5 2.5" />
+  </Icon>
+);
+
+export const ChevronDownIcon = (props: SVGProps<SVGSVGElement>) => (
+  <Icon strokeWidth={2.4} {...props}>
+    <path d="m6 9 6 6 6-6" />
