# Copia este archivo como .env para desarrollo local.
NODE_ENV=development
PORT=3000

# Base de datos (coincide con el servicio "db" de docker-compose)
DATABASE_URL=postgresql://lumini:lumini@localhost:5432/lumini

# Genera secretos con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio
JWT_PARENT_SECRET=cambia-este-secreto-de-modo-padres-por-uno-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
PARENT_SESSION_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7

# Proxies delante de la API (nginx en Docker = 1). Afecta la IP usada en el rate limiting.
TRUST_PROXY_HOPS=1

# Lumi (preguntas con IA en el pozo de los deseos). Sin clave, la función queda apagada.
# Crea una clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
LUMI_MODEL=gemini-3.1-flash-lite
LUMI_QUESTION_COST=5
LUMI_DAILY_LIMIT=10

# Orígenes permitidos (separados por coma). Incluye los de Capacitor para el APK.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
